entity_filter:
  include:
    entities: []
    entity_globs:
      - "*temperature*"
  exclude:
    entity_globs: []
    entities: []

default_metric: pc_monthly_energy

metrics:
  pc_monthly_energy:
    entity_id: sensor.pc_monthly_energy_consumption
    name: "PC monthly energy"
    type: line
    chart_options:
      smooth: true
